{
  "name": "bad-matchup",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "description": "Badminton session matchmaker - offline first, with optional live rooms",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bad-matchup \"vitest run rules-tests\"",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --only firestore,auth"
  },
  "dependencies": {
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/itim": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/kodchasan": "^5.3.0",
    "@fontsource/mali": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@fontsource/pattaya": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sriracha": "^5.3.0",
    "@fontsource/taviraj": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}

rules_version = '2';

// Live rooms (src/lib/roomRemote.js). One document per room: anyone holding
// the link may read it, only the device that opened it may change it.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      // the whole shape, so a room can never grow fields the app does not know
      function wellFormed() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'session', 'v', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['ownerUid', 'session', 'v', 'createdAt', 'updatedAt'])
          && d.session is string
          && d.session.size() < 600000
          && d.v is int
          && d.updatedAt == request.time;
      }

      // `get`, not `read`: knowing the id is required — rooms cannot be listed
      allow get: if true;

      allow create: if signedIn()
        && wellFormed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && wellFormed()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}

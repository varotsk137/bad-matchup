# `npm run dev:emulator` — talks to `npm run emulators` instead of the real
# project. The emulators accept any key, so nothing real is needed here.
VITE_FIREBASE_EMULATOR=1
VITE_FIREBASE_API_KEY=emulator-only
VITE_FIREBASE_AUTH_DOMAIN=bad-matchup.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bad-matchup
VITE_FIREBASE_APP_ID=emulator-only

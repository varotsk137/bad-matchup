# Firebase web config for live rooms. Copy this file to `.env.local` (which git
# ignores) and fill it in from Firebase console → Project settings → Your apps.
# The deploy workflow reads the same names from the repository's Actions
# secrets (Settings → Secrets and variables → Actions → Secrets).
#
# Leave them empty and the app still builds and works offline; only opening
# or watching a live room needs them. `npm run dev:emulator` needs none of
# this (see .env.emulator).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
